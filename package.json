{
  "name": "team-report",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run --parallel dev:app dev:proxy",
    "dev:app": "vite",
    "dev:proxy": "bun run --cwd proxy dev ${PROXY_ALLOWED_ORIGINS:+--var ALLOWED_ORIGINS:$PROXY_ALLOWED_ORIGINS}",
    "dev:tunnel": "./scripts/cloudflare-tunnel.sh",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.0",
    "@trystero-p2p/nostr": "0.26.0",
    "@xyflow/react": "^12.12.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-select": "^5.10.2",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^6.4.3"
  }
}
